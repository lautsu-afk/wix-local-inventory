  "menu_descriptions_by_main_id": {
    "8f2814a1-f45e-5648-315a-8907b72114a6": "Rakennustarvikkeet- ja tuotteet -kategoriasta löydät tuotteita rakentamiseen, korjaamiseen ja asennustöihin. Kategoria sopii pieniin remontteihin ja täydentäviin hankintoihin. Valikoima koostuu poistotuotteista.",
    "38c4ba99-41fd-32ae-640e-136e77d12411": "Maataloustarvikkeet-kategoriasta löydät käytännöllisiä tuotteita maatilan arkeen, huoltoon ja käyttöön. Kategoria kokoaa yhteen tarvikkeita päivittäisiin tarpeisiin. Valikoima koostuu poistotuotteista.",
    "0800133e-b48f-7130-b65a-dd85fa384a14": "",
    "64d19278-d6e4-caad-4f3f-0bdc1878d84e": "Työkalut-kategoriasta löydät tuotteita työskentelyyn, asennuksiin, huoltoon ja remontointiin. Kategoria sopii sekä kotikäyttäjälle että ammattilaiselle. Valikoima koostuu poistotuotteista.",
    "ff30c235-4779-e0f5-9500-f130b4c63a8e": ""
  },
